# syntax=docker/dockerfile:1
# RunPod-specific Triton image.
# Unlike Dockerfile (local dev), this one:
#   - adds openssh-server so RunPod web terminal / SSH works
#   - installs gliner2 from PyPI (no local submodule needed)
#   - has a start.sh that clones model_repository from git and starts tritonserver
#
# Build & push (from repo root):
#   docker build --platform linux/amd64 -f triton-serve/Dockerfile.runpod -t <user>/triton-gliner:latest .
#   docker push <user>/triton-gliner:latest

FROM nvcr.io/nvidia/tritonserver:25.01-py3

WORKDIR /workspace

# SSH for RunPod terminal access
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && echo "PermitRootLogin yes" >> /etc/ssh/sshd_config \
    && echo "PasswordAuthentication no" >> /etc/ssh/sshd_config

# Базовый образ Triton содержит libtorch (C++) для своего PyTorch backend,
# но НЕ устанавливает Python-пакет torch в системный Python.
# Без пина версии — pip берёт хэш и файл из одного индекса, что исключает mismatch.
# --mount=type=cache: BuildKit кэширует .whl между запусками, ретрай не качает заново.
# cu121 совместим с CUDA 12.3 (CUDA backward compatible внутри major версии).
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --timeout 1200 --retries 10 \
    torch \
    --index-url https://download.pytorch.org/whl/cu121

# Зависимости gliner/gliner2 (torch уже выше)
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --timeout 300 --retries 5 \
    transformers \
    huggingface_hub \
    scipy \
    "pydantic>=2.0.0" \
    "tritonclient[all]" \
    onnxruntime-gpu

# gliner/gliner2 — без зависимостей (все deps выше)
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --no-deps --timeout 300 --retries 5 gliner gliner2

# Проверяем импорты и записываем точный путь к site-packages.
# model.py читает /python_site_packages.txt при старте — без угадывания путей.
RUN python3 -c "import torch; print('torch', torch.__version__, 'at', torch.__file__)"
RUN python3 -c "from gliner2 import GLiNER2; print('gliner2 ok')"
RUN python3 -c "import site, json, sys; p=site.getsitepackages(); print('Python:', sys.executable); print('site-packages:', p); open('/python_site_packages.txt','w').write(json.dumps(p))"

# Startup script
COPY triton-serve/start_runpod.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 22 8000 8001 8002

CMD ["/start.sh"]
