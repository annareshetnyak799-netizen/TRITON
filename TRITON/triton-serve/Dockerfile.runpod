# RunPod-specific Triton image.
# Unlike Dockerfile (local dev), this one:
#   - adds openssh-server so RunPod web terminal / SSH works
#   - installs gliner2 from PyPI (no local submodule needed)
#   - has a start.sh that clones model_repository from git and starts tritonserver
#
# Build & push (from repo root):
#   docker build --platform linux/amd64 -f triton-serve/Dockerfile.runpod -t <user>/triton-gliner:latest .
#   docker push <user>/triton-gliner:latest

FROM nvcr.io/nvidia/tritonserver:25.01-py3

WORKDIR /workspace

# SSH for RunPod terminal access
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && echo "PermitRootLogin yes" >> /etc/ssh/sshd_config \
    && echo "PasswordAuthentication no" >> /etc/ssh/sshd_config

# Python deps.
# --no-deps для gliner/gliner2: torch уже есть в базовом образе Triton.
# Явно устанавливаем только non-torch зависимости.
RUN python3 -m pip install --no-cache-dir --timeout 300 --retries 5 \
    requests \
    transformers \
    huggingface_hub \
    scipy \
    "pydantic>=2.0.0" \
    "tritonclient[all]"

RUN python3 -m pip install --no-cache-dir --no-deps --timeout 300 --retries 5 gliner gliner2

# Проверяем импорты и записываем точный путь к site-packages в файл.
# model.py читает /python_site_packages.txt при старте — никакого угадывания путей.
RUN python3 -c "import torch; print('torch', torch.__version__, 'at', torch.__file__)"
RUN python3 -c "from gliner2 import GLiNER2; print('gliner2 ok')"
RUN python3 -c "import site, json, sys; p=site.getsitepackages(); print('site-packages:', p); print('Python:', sys.executable); open('/python_site_packages.txt','w').write(json.dumps(p))"

# Startup script
COPY triton-serve/start_runpod.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 22 8000 8001 8002

CMD ["/start.sh"]
