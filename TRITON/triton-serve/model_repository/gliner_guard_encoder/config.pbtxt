# Triton PyTorch backend for GLiNER2 encoder (TorchScript model.pt).
#
# This is the "native PyTorch" backend: Triton loads model.pt directly via
# C++ libtorch — no Python interpreter overhead for the encoder forward pass.
#
# Used inside gliner_ensemble:
#   gliner_preprocessor (Python) → [this model] → gliner_postprocessor (Python)
#
# model.pt is generated by triton-serve/export/export_torchscript.py.
# It exports EncoderWrapper(encoder) — takes input_ids + attention_mask,
# returns last_hidden_state [batch, seq_len, hidden=384].
#
# Input dtype note: matches the trace in export_torchscript.py:
#   input_ids:       int64  (randint trace)
#   attention_mask:  float32 (ones trace)

name: "gliner_guard_encoder"
backend: "pytorch"

max_batch_size: 64

dynamic_batching {
  preferred_batch_size: [ 1, 8, 16, 32, 64 ]
  max_queue_delay_microseconds: 50000
}

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

output [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [ -1, 384 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
