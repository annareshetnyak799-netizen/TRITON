name: "gliner_postprocessor"
backend: "python"

max_batch_size: 64

dynamic_batching {
  preferred_batch_size: [ 1, 8, 16, 32, 64 ]
  max_queue_delay_microseconds: 50000
}

# Inputs:
#   last_hidden_state  ← gliner_guard_encoder output
#   text_word_indices  ← gliner_preprocessor output (passthrough via ensemble)
#   meta               ← gliner_preprocessor output (passthrough via ensemble)
input [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [ -1, 384 ]
  },
  {
    name: "text_word_indices"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "meta"
    data_type: TYPE_BYTES
    dims: [ 1 ]
  }
]

output [
  {
    name: "result"
    data_type: TYPE_BYTES
    dims: [ 1 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]
