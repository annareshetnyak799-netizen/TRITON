# Triton ONNX Runtime backend for GLiNER2 encoder (ModernBERT).
#
# Native C++ inference via ONNX Runtime — no Python interpreter overhead.
# model.onnx is generated by triton-serve/export/export_onnx.py.
#
# Why ONNX instead of TorchScript (PyTorch backend):
#   ModernBERT's create_bidirectional_mask passes a 0-dim scalar tensor as
#   q_length to sdpa_mask. torch.jit.trace fails with IndexError.
#   torch.onnx.export with dynamo=True uses AOT compilation — no tracing issue.
#
# Part of gliner_ensemble:
#   gliner_preprocessor (Python) → [this model] → gliner_postprocessor (Python)

name: "gliner_guard_encoder_onnx"
backend: "onnxruntime"

max_batch_size: 64

dynamic_batching {
  preferred_batch_size: [ 1, 8, 16, 32, 64 ]
  max_queue_delay_microseconds: 50000
}

optimization {
  graph { level: 3 }
}

input [
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [ -1 ]
  },
  {
    name: "attention_mask"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

output [
  {
    name: "last_hidden_state"
    data_type: TYPE_FP32
    dims: [ -1, 384 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 4
  }
]
